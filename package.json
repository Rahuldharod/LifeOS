{
  "name": "lifeos",
  "private": true,
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "start": "node scripts/lifeos.mjs start",
    "stop": "node scripts/lifeos.mjs stop",
    "status": "node scripts/lifeos.mjs status",
    "update-app": "node scripts/lifeos.mjs update",
    "reconcile-meetings": "node --import tsx scripts/reconcile-meetings.mts",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "worktrees:check": "node scripts/prune-worktrees.mjs --check",
    "dev": "node scripts/seed-dev-data.mjs && corepack pnpm --parallel --filter @lifeos/server --filter @lifeos/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@lifeos/ai": "workspace:*",
    "@lifeos/application": "workspace:*",
    "@lifeos/assets-filesystem": "workspace:*",
    "@lifeos/backup-filesystem": "workspace:*",
    "@lifeos/connectors": "workspace:*",
    "@lifeos/index-memory": "workspace:*",
    "@lifeos/object-store-markdown": "workspace:*",
    "@lifeos/secrets": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
