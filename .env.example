LIFEOS_HOST=127.0.0.1
LIFEOS_PORT=4310
# Optional override. Relative values resolve from the server process working directory.
# LIFEOS_DATA_ROOT=../../../data
# LIFEOS_BACKUP_ROOT=../../../backups
LIFEOS_DEVICE_ID=local-development

# Google Calendar OAuth. Create a Desktop OAuth client in Google Cloud Console.
# The client ID is configuration; store the client secret in macOS Keychain when possible.
# GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=temporary-development-bootstrap-only
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4310/api/v1/connections/google/callback
